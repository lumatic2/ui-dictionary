{
  "$description": "Askewly Design token SSOT (DTCG-compatible, stable 2025.10 subset). Tier rule: component -> semantic -> primitive, one direction only. Dark mode lives in $extensions['com.askewly.modes'].dark on semantic tokens. Generated artifacts: DESIGN.md frontmatter, examples/ui-vocabulary-site/src/tokens.css. Do not edit generated files by hand.",
  "color": {
    "primitive": {
      "$description": "Raw values only. gray is the site's violet-tinted neutral (hue 270) formalized as a 12-step ramp; usage convention: 1-2 app background, 3-5 interactive component states, 6-8 borders, 9-10 solid/low-contrast foreground, 11-12 text.",
      "white": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
      "gray": {
        "$type": "color",
        "1": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
        "2": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.005, 270] } },
        "3": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.015, 270] } },
        "4": { "$value": { "colorSpace": "oklch", "components": [0.94, 0.02, 270] } },
        "5": { "$value": { "colorSpace": "oklch", "components": [0.91, 0.015, 270] } },
        "6": { "$value": { "colorSpace": "oklch", "components": [0.88, 0.015, 270] } },
        "7": { "$value": { "colorSpace": "oklch", "components": [0.72, 0.02, 270] } },
        "8": { "$value": { "colorSpace": "oklch", "components": [0.6, 0.025, 270] } },
        "9": { "$value": { "colorSpace": "oklch", "components": [0.46, 0.03, 270] } },
        "10": { "$value": { "colorSpace": "oklch", "components": [0.35, 0.03, 270] } },
        "11": { "$value": { "colorSpace": "oklch", "components": [0.25, 0.03, 270] } },
        "12": { "$value": { "colorSpace": "oklch", "components": [0.16, 0.015, 270] } }
      },
      "askewly": {
        "$type": "color",
        "$description": "Brand palette extracted from the landing planning reference image (2026-07-05). Canonical purple: violet.",
        "violet": { "$value": { "colorSpace": "srgb", "components": [0.435294, 0.176471, 0.741176], "hex": "#6F2DBD" } },
        "orchid": { "$value": { "colorSpace": "srgb", "components": [0.65098, 0.388235, 0.8], "hex": "#A663CC" } },
        "lavender": { "$value": { "colorSpace": "srgb", "components": [0.698039, 0.596078, 0.862745], "hex": "#B298DC" } },
        "sky": { "$value": { "colorSpace": "srgb", "components": [0.721569, 0.815686, 0.921569], "hex": "#B8D0EB" } },
        "mint": { "$value": { "colorSpace": "srgb", "components": [0.72549, 0.980392, 0.972549], "hex": "#B9FAF8" } },
        "violet-deep": {
          "$description": "Hover shade of the canonical brand violet (M2 2026-08-01, promoted from hardcoded #5f22a8).",
          "$value": { "colorSpace": "srgb", "components": [0.372549, 0.133333, 0.658824], "hex": "#5F22A8" }
        }
      },
      "red": {
        "$type": "color",
        "9": { "$value": { "colorSpace": "oklch", "components": [0.58, 0.22, 27] } }
      },
      "indigo": {
        "$type": "color",
        "$description": "Emphasis/selection accent ramp (M2 2026-08-01). Values = Tailwind v4 defaults the site already rendered, promoted verbatim for light-mode visual losslessness.",
        "50": { "$value": { "colorSpace": "oklch", "components": [0.962, 0.018, 272.314] } },
        "300": { "$value": { "colorSpace": "oklch", "components": [0.785, 0.115, 274.713] } },
        "400": { "$value": { "colorSpace": "oklch", "components": [0.673, 0.182, 276.935] } },
        "500": { "$value": { "colorSpace": "oklch", "components": [0.585, 0.233, 277.117] } },
        "600": { "$value": { "colorSpace": "oklch", "components": [0.511, 0.262, 276.966] } },
        "700": { "$value": { "colorSpace": "oklch", "components": [0.457, 0.24, 277.023] } },
        "950": { "$value": { "colorSpace": "oklch", "components": [0.257, 0.09, 281.288] } }
      },
      "skyx": {
        "$type": "color",
        "$description": "Informational accent ramp (M2 2026-08-01, Tailwind v4 sky — named skyx to avoid clashing with brand askewly.sky).",
        "100": { "$value": { "colorSpace": "oklch", "components": [0.951, 0.026, 236.824] } },
        "300": { "$value": { "colorSpace": "oklch", "components": [0.828, 0.111, 230.318] } },
        "400": { "$value": { "colorSpace": "oklch", "components": [0.746, 0.16, 232.661] } },
        "500": { "$value": { "colorSpace": "oklch", "components": [0.685, 0.169, 237.323] } },
        "600": { "$value": { "colorSpace": "oklch", "components": [0.588, 0.158, 241.966] } },
        "700": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.134, 242.749] } },
        "950": { "$value": { "colorSpace": "oklch", "components": [0.293, 0.066, 243.157] } }
      },
      "emerald": {
        "$type": "color",
        "$description": "Success accent ramp (M2 2026-08-01, Tailwind v4 defaults).",
        "50": { "$value": { "colorSpace": "oklch", "components": [0.979, 0.021, 166.113] } },
        "300": { "$value": { "colorSpace": "oklch", "components": [0.845, 0.143, 164.978] } },
        "700": { "$value": { "colorSpace": "oklch", "components": [0.508, 0.118, 165.612] } },
        "950": { "$value": { "colorSpace": "oklch", "components": [0.262, 0.051, 172.552] } }
      },
      "rose": {
        "$type": "color",
        "$description": "Danger accent ramp (M2 2026-08-01, Tailwind v4 defaults). Distinct from red.9 (--destructive): the site's danger demos render rose, and the shades intentionally differ.",
        "100": { "$value": { "colorSpace": "oklch", "components": [0.941, 0.03, 12.58] } },
        "400": { "$value": { "colorSpace": "oklch", "components": [0.712, 0.194, 13.428] } },
        "500": { "$value": { "colorSpace": "oklch", "components": [0.645, 0.246, 16.439] } },
        "600": { "$value": { "colorSpace": "oklch", "components": [0.586, 0.253, 17.585] } },
        "950": { "$value": { "colorSpace": "oklch", "components": [0.271, 0.105, 12.094] } }
      }
    },
    "semantic": {
      "$description": "Role tokens. Components and site CSS consume this layer only. Dark values in $extensions['com.askewly.modes'].dark.",
      "surface": {
        "$type": "color",
        "base": {
          "$value": "{color.primitive.gray.1}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.12}" } }
        },
        "raised": {
          "$description": "Cards, panels sitting on base.",
          "$value": "{color.primitive.white}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.11}" } }
        },
        "overlay": {
          "$description": "Popovers, dropdowns, floating layers.",
          "$value": "{color.primitive.white}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.11}" } }
        },
        "scrim": {
          "$description": "Dimming layer behind modals, sheets and lightboxes. Deliberately has NO dark override — a scrim means 'press the background down', so it must read dark in both modes. Consumers own the opacity (bg-scrim/50, /72).",
          "$value": "{color.primitive.gray.12}"
        },
        "muted": {
          "$value": "{color.primitive.gray.3}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.10}" } }
        },
        "secondary": {
          "$description": "Secondary button / subtle filled surface.",
          "$value": "{color.primitive.gray.4}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.10}" } }
        },
        "tint": {
          "$description": "Informational wash, agent-ready signal surface.",
          "$value": "{color.primitive.askewly.mint}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.10}" } }
        }
      },
      "text": {
        "$type": "color",
        "default": {
          "$value": "{color.primitive.gray.12}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.1}" } }
        },
        "muted": {
          "$value": "{color.primitive.gray.9}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.7}" } }
        },
        "secondary": {
          "$description": "Foreground on surface.secondary.",
          "$value": "{color.primitive.gray.11}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.3}" } }
        },
        "on-accent": {
          "$description": "Text/icon on action.primary solid fills.",
          "$value": "{color.primitive.gray.1}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.12}" } }
        },
        "on-destructive": {
          "$description": "Text/icon on action.destructive solid fills. Theme-invariant white (M2: promotes the settled 'text-white is correct' marker verdict into a token).",
          "$value": "{color.primitive.white}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.white}" } }
        }
      },
      "action": {
        "$type": "color",
        "primary": {
          "$value": "{color.primitive.askewly.violet}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.1}" } }
        },
        "primary-hover": {
          "$description": "Hover state for brand-violet fills/text (M2). Dark uses the brighter orchid — darkening on hover loses contrast on dark surfaces.",
          "$value": "{color.primitive.askewly.violet-deep}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.askewly.orchid}" } }
        },
        "secondary": {
          "$value": "{color.primitive.askewly.orchid}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.askewly.mint}" } }
        },
        "destructive": {
          "$value": "{color.primitive.red.9}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.red.9}" } }
        }
      },
      "emphasis": {
        "$type": "color",
        "$description": "Selection/emphasis accent (indigo family, M2 2026-08-01). Distinct from 'accent' (shadcn interaction-state wash, mint family) — do not merge (group-semantics collision, fresh-verifier finding).",
        "surface": {
          "$description": "Chip/selected-row wash.",
          "$value": "{color.primitive.indigo.50}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.indigo.950}" } }
        },
        "foreground": {
          "$description": "Text on emphasis.surface.",
          "$value": "{color.primitive.indigo.700}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.indigo.300}" } }
        },
        "solid": {
          "$description": "Solid emphasis fill (buttons).",
          "$value": "{color.primitive.indigo.600}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.indigo.500}" } }
        },
        "solid-hover": {
          "$value": "{color.primitive.indigo.500}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.indigo.400}" } }
        },
        "ring": {
          "$description": "Focus border/ring on emphasis-accented inputs.",
          "$value": "{color.primitive.indigo.500}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.indigo.400}" } }
        },
        "on-solid": {
          "$description": "Text/icon on emphasis.solid fills. White holds contrast on indigo-600 (light) and indigo-500 (dark).",
          "$value": "{color.primitive.white}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.white}" } }
        }
      },
      "status": {
        "$type": "color",
        "$description": "Status colors (M2 2026-08-01). info=sky, success=emerald, danger=rose. Kept out of 'accent' (interaction-state group).",
        "info-surface": {
          "$value": "{color.primitive.skyx.100}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.skyx.950}" } }
        },
        "info-foreground": {
          "$value": "{color.primitive.skyx.700}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.skyx.300}" } }
        },
        "info-link": {
          "$description": "Standalone info-accented link/action text.",
          "$value": "{color.primitive.skyx.500}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.skyx.400}" } }
        },
        "info-link-hover": {
          "$value": "{color.primitive.skyx.600}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.skyx.300}" } }
        },
        "success-surface": {
          "$value": "{color.primitive.emerald.50}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.emerald.950}" } }
        },
        "success-foreground": {
          "$value": "{color.primitive.emerald.700}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.emerald.300}" } }
        },
        "danger-surface": {
          "$value": "{color.primitive.rose.100}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.rose.950}" } }
        },
        "danger-foreground": {
          "$value": "{color.primitive.rose.600}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.rose.400}" } }
        },
        "danger-solid": {
          "$value": "{color.primitive.rose.600}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.rose.600}" } }
        },
        "danger-solid-hover": {
          "$value": "{color.primitive.rose.500}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.rose.500}" } }
        }
      },
      "accent": {
        "$type": "color",
        "base": {
          "$description": "Informational accent wash (mint family).",
          "$value": "{color.primitive.askewly.mint}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.10}" } }
        },
        "foreground": {
          "$value": "{color.primitive.gray.12}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.1}" } }
        }
      },
      "border": {
        "$type": "color",
        "default": {
          "$value": "{color.primitive.gray.6}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.10}" } }
        },
        "input": {
          "$value": "{color.primitive.gray.6}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.gray.10}" } }
        },
        "focus": {
          "$description": "Focus ring.",
          "$value": "{color.primitive.askewly.violet}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.askewly.lavender}" } }
        },
        "accent": {
          "$description": "Selected/active edges only.",
          "$value": "{color.primitive.askewly.lavender}",
          "$extensions": { "com.askewly.modes": { "dark": "{color.primitive.askewly.orchid}" } }
        }
      }
    },
    "component": {
      "$description": "Minimal by policy (survey criterion A-5): only overrides that semantic roles cannot express. Exemplar tier for the lint chain.",
      "button": {
        "$type": "color",
        "bg": { "$value": "{color.semantic.action.primary}" },
        "text": { "$value": "{color.semantic.text.on-accent}" }
      }
    }
  },
  "dimension": {
    "space": {
      "$type": "dimension",
      "$description": "4/8 grid. Reference variables only - not bound into the Tailwind theme namespace.",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "$description": "Canonical = shipped site values (PSS1 visually approved), not the older 2/4px draft.",
      "sm": { "$value": { "value": 4, "unit": "px" } },
      "md": { "$value": { "value": 6, "unit": "px" } },
      "lg": { "$value": { "value": 8, "unit": "px" } },
      "xl": { "$value": { "value": 12, "unit": "px" } },
      "2xl": {
        "$description": "SD gen2 (2026-07-12): large-surface corner radius for sheets/overlays that sit above the base scale — device-frame inner viewport, bottom-sheet-detents. Recurs identically in >=2 mobile components as Tailwind's built-in rounded-2xl (16px), currently outside the tokenized sm-xl range.",
        "$value": { "value": 16, "unit": "px" }
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fixed-purpose sizing constants that are not part of the 4/8 spacing grid. SD gen2 (2026-07-12): touch-target minimum recurs across mobile surfaces (large-title-collapsing-header back button, mobile-signup-field-stack inputs/submit, plus pre-existing search-autocomplete/showcase-card/term-visual usage) as Tailwind size-11/h-11/min-h-11 (44px) — the WCAG 2.5.5 / iOS HIG minimum hit target.",
      "touch-target-min": { "$value": { "value": 44, "unit": "px" } }
    },
    "z-index": {
      "$type": "number",
      "$description": "SD gen2 (2026-07-12): layering scale distilled from recurring hardcoded z-index values across mobile overlays and dense-data sticky headers. 'sticky' = content pinned within its own scroll container (collapsing header bar, bottom-sheet/action-sheet root within DeviceFrame, table sticky header row). 'elevated' = a second layer above a sticky layer in the same local stacking context (permission-matrix-editor-grid's sticky corner cell, which must sit above both its own header row and column). 'overlay' = page-level modal/scrim/popover stacking context (ui/dialog, ui/sheet, ui/popover, ui/tooltip, full-screen confirm overlays).",
      "sticky": { "$value": 10 },
      "elevated": { "$value": 20 },
      "overlay": { "$value": 50 }
    }
  },
  "typography": {
    "font": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist", "Noto Sans KR", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    },
    "scale": {
      "$type": "dimension",
      "$description": "M6 2026-08-01: expanded to the 9 steps screens actually render (M1 closeout measurement). New steps (2xs/xs/3xl/5xl/7xl) carry Tailwind v4 default values verbatim in rem — they are wired into @theme --text-* so existing utility classes route through the SSOT with zero render change. Legacy 5 names (sm/base/lg/xl/2xl, px) are kept for backward compat; lg(20) and 2xl(40) differ from Tailwind's same-named defaults and are NOT wired.",
      "2xs": {
        "$description": "Micro labels (10px at default root). New utility text-2xs — Tailwind has no built-in 2xs.",
        "$value": { "value": 0.625, "unit": "rem" }
      },
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "base": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 20, "unit": "px" } },
      "xl": {
        "$description": "Unused by live screens as of M1 measurement (2026-08-01) — kept as record for llms consumers.",
        "$value": { "value": 28, "unit": "px" }
      },
      "2xl": { "$value": { "value": 40, "unit": "px" } },
      "3xl": { "$value": { "value": 1.875, "unit": "rem" } },
      "5xl": { "$value": { "value": 3, "unit": "rem" } },
      "7xl": { "$value": { "value": 4.5, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 }
    }
  },
  "motion": {
    "$description": "SD gen2 (2026-07-12): motion timing constants. Kept minimal by the same policy as color.component — only the value that actually recurs, not a full scale invented ahead of need.",
    "duration": {
      "$type": "duration",
      "overlay": {
        "$description": "Open/close transition for modal-style surfaces. Recurs identically (200ms) in bottom-sheet-detents.tsx and ui/dialog.tsx.",
        "$value": { "value": 200, "unit": "ms" }
      }
    }
  }
}
