{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askewly.local/schemas/presentation-slides-yusung/slides.schema.json",
  "title": "presentation-slides-yusung slides.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "slides"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "template",
        "mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "template": {
          "enum": [
            "dark",
            "light",
            "askewly",
            "minimax"
          ]
        },
        "mode": {
          "enum": [
            "arrow",
            "scroll-snap"
          ]
        },
        "canvas": {
          "enum": [
            "hd"
          ],
          "default": "hd"
        },
        "effects": {
          "enum": [
            "none",
            "rise",
            "scale",
            "fade",
            "focus"
          ],
          "default": "rise"
        },
        "typography": {
          "enum": [
            "standard",
            "compact",
            "executive"
          ],
          "default": "standard"
        },
        "language": {
          "type": "string",
          "default": "ko"
        },
        "aspectRatio": {
          "enum": [
            "16:9"
          ]
        },
        "speakerNotes": {
          "type": "boolean",
          "default": true
        },
        "themeNotes": {
          "type": "string"
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "range": {
          "type": "string"
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "no",
        "slug",
        "section",
        "layout",
        "title"
      ],
      "properties": {
        "no": {
          "type": "integer",
          "minimum": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "cover",
            "closing",
            "hero-cards",
            "comparison-2col",
            "step-flow",
            "diagram-box",
            "summary-grid",
            "case-map",
            "split-screen",
            "timeline-cards",
            "pipeline-lanes",
            "result-transitions",
            "chart-interactive",
            "three-scene",
            "before-after",
            "qr-embed",
            "hero-motion",
            "svg-filter-scene"
          ]
        },
        "kicker": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "recipe": {
          "type": "string",
          "description": "Legacy/internal visual recipe namespace for an existing layout. Prefer top-level variant for new decks."
        },
        "variant": {
          "type": "string",
          "description": "Preferred visual variant for the selected layout, e.g. delta-table, feature-mosaic, ranked-bars, or balance-radar."
        },
        "chartType": {
          "enum": [
            "bar",
            "line",
            "radar",
            "doughnut",
            "polarArea"
          ],
          "description": "Optional Chart.js primitive override. Prefer variant for new chart slides."
        },
        "chartLabel": {
          "type": "string"
        },
        "recipeUse": {
          "type": "string",
          "description": "Human-readable note for G2 review explaining how the recipe slots are used."
        },
        "recipeOptions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Legacy/internal recipe parameters. Prefer top-level variant for new decks."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "properties": {
            "image": {
              "type": "string"
            },
            "screenshot": {
              "type": "string"
            },
            "video": {
              "type": "string"
            },
            "audio": {
              "type": "string"
            },
            "poster": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "qr": {
              "type": "string"
            },
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            },
            "visual": {
              "type": "string"
            },
            "frame": {
              "enum": [
                "device"
              ]
            },
            "helper": {
              "enum": [
                "architecture",
                "metric-card",
                "source-badge"
              ]
            },
            "caption": {
              "type": "string"
            },
            "sourceBadge": {
              "type": "string"
            },
            "placeholder": {
              "type": "string"
            },
            "pattern": {
              "type": "boolean"
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "sourceNote": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "none",
            "rise",
            "scale",
            "fade",
            "focus"
          ]
        },
        "typography": {
          "enum": [
            "standard",
            "compact",
            "executive"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "exportFallback": {
          "type": "string"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      }
    },
    "icon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "library": {
              "enum": [
                "lucide",
                "lobe",
                "inline-svg"
              ],
              "default": "lucide"
            },
            "label": {
              "type": "string"
            },
            "svg": {
              "type": "string"
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "reliability": {
          "enum": [
            "primary",
            "official",
            "secondary",
            "weak",
            "unknown"
          ]
        }
      }
    }
  }
}